# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend Client URL (for CORS)
# Production: CLIENT_URL=https://salonbook-virid.vercel.app
# Local Development: CLIENT_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Better Auth Configuration
# Production (same-origin proxy): BETTER_AUTH_URL=https://salonbook-virid.vercel.app
# Local Development: BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=your_better_auth_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Authorized Administrator Email
ADMIN_EMAIL=admin@example.com

# ImgBB Image Upload API Key
IMGBB_API_KEY=your_imgbb_api_key

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# Frontend Application URL (for Stripe Checkout redirects)
FRONTEND_URL=http://localhost:3000
